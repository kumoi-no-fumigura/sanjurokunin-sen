 "poems": [
  {
   "seq": "1",
   "text": "きのふこそ年は暮しか春霞かすかの山にはやたちにけり",
   "kana": "",
   "speaker": "人丸十首",
   "page": 231,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "明日からは若な摘まむと片岡のあしたの原はけふそやくめる",
   "kana": "",
   "speaker": "",
   "page": 231,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "梅花それともみえす久かたのあまきる雪のなへてふれゝは",
   "kana": "",
   "speaker": "",
   "page": 231,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "郭公なくや五月の短か夜もひとりしぬれは明しかねつも",
   "kana": "",
   "speaker": "三十六人撰",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "あすか川紅葉はなかるかつらきの山の秋風ふきそしぬらし",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "ほの〓〓と明しの浦のあさ霧に島かくれゆく船をしそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "賴めつゝ來ぬ夜數多に成ぬれはまたしと思ふそ待にまされる",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "足引の山鳥のおのしたりおのなか〓〓し夜をひとりかもねん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "わきも子かねくたれ髪をさる澤の池の玉もと見るそかなしき",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "ものゝふの八十うち川のはやきせに漂ふ浪のよるべしらすも",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "とふ人もなきやとなれとくる春は八重葎にもさはらさりけり",
   "kana": "",
   "speaker": "貫之十首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "行てみぬ人もしのへと春の野のかたみにつめる若菜なりけり",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "花もみな散ぬるやとは行春のふるさとゝこそ成ぬへらなれ",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "夏の夜のふすかとすれは郭公なくひと聲にあくるしのゝめ",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "みる人もなくて散ぬるおく山の紅葉はよるの錦成けり",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "櫻ちる木のした風は寒からて空にしられぬ雪そふりける",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "こぬ人をしたに待つゝ久かたの月を哀といはぬ夜そなき",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "思ひかねいもかりゆけは冬の夜の川風さむみ千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "君まさて煙たえにししほかまの浦さひしくも見え渡るかな",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "あふ坂の關の〓水にかけ見えて今やひくらんもち月の駒",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "春たつと聞つるからに春日山きえあえぬ雪の花と見ゆらん",
   "kana": "",
   "speaker": "躬恒三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "かをとめて誰おらさらむ梅のはなあやなし霞立なかくしそ",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "山高み雲井にみゆる櫻花こゝろの行ておらぬ日そなき",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "我やとの花見かてらに來る人は散なん後そこひしかるへき",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "けふのみと春を思はぬ時たにもたつとやすき花のかけかは",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "時鳥よふかき聲は月見るとゐもねてあかす人そ聞ける",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "たちとまりみてを渡らん紅葉ゝは雨とふるとも水はまさらし",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "心あてにおらはやおらん初霜のをきまとはせるしら菊の花",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "我戀は行衞もしらすはてもなしあふをかきりと思ふはかりそ",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "ひきうへし人はむへこそ老にけれ松の木高く成てける哉",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "靑柳のえたにかゝれる春雨はいともてぬける玉かとそみる",
   "kana": "",
   "speaker": "伊勢十首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "千とせふる松といへとも植てみる人そ數へてしるへかりける",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "年をへて花の鏡となる水はちりかゝるをや曇るとみるらん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "散ちらすきかまほしきを古〓の花みてかへる人もあはなん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "いつくまて春は行らん暮はてゝわかれしほとは夜になりにき",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "二聲と聞とはなしに郭公よふかくめをもさましつるかな",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "三輪の山いかに待みん年ふともたつぬる人もあらしと思へは",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "うつろはん事たにおしき秋萩におれぬはかりもをける白露",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "人しれす立なましかは佗つゝもなき名とたにも言はまし物を",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "難波なるなからの橋もつくる也いまはわか身を何にたとへん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "新玉の年たちかへるあしたよりまたるゝは物は鶯のこゑ",
   "kana": "",
   "speaker": "大伴家持三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "さをしかの朝たつをのゝ秋萩に玉とみるまてをけるしら露",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "春の野にあさるきゝすの妻戀にをのか有かを人にしれつゝ",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "明日からは若菜つまむとしめしのに昨日もけふも雪は降つゝ",
   "kana": "",
   "speaker": "赤人三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "我せこにみせんと思ひし梅の花それともみえす雪のふれゝは",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "わかの浦に鹽みちくれはかたを浪あしへをさして田鶴鳴渡る",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "世中にたえて櫻のなかりせは春の心はのとけからまし",
   "kana": "",
   "speaker": "業平三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "たのめつゝとはて年ふる僞にこりぬ心を人はしらなむ",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "今そしる苦しきものと人またむ里をはかれすとふへかりけり",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "すゑの露もとの雫や世中のをくれ先立つためし成らん",
   "kana": "",
   "speaker": "遍昭三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "我やとは道もなきまて荒にけり難面き人を待とせしまに",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "たらちねはかゝれとて、こそ鳥羽玉の我黑髪をなてすや有けん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "今こむといひしはかりに長月の有明の月を待出つるかな",
   "kana": "",
   "speaker": "素",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "見てのみや人にかたらん山櫻手ことに折て家つとにせむ",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "みわたせは柳櫻をこきませて都そ春のにしき成ける",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "夕さればさほの川原のかは霧に友まとはせる千鳥鳴也",
   "kana": "",
   "speaker": "友則三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "雪降は木〓とに花そ咲にけるいつれを梅と分てをらまし",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "秋風に初かりかねそ聞ゆなる誰玉つさをかけてきつらん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "遠近のたつきもしらぬ山中におほつかなくもよふこ鳥かな",
   "kana": "",
   "speaker": "猿丸太夫三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "日くらしの鳴つるなへに日は暮ぬと思へは山の陰にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "おく山の紅葉ふみ分鳴く鹿の聲きく時そ秋はかなしき",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "花の色はうつりにけりな徒に我身世にふるなかめせしまに",
   "kana": "",
   "speaker": "小野小町三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "思ひつゝぬれはや人のみえつらん夢としりせは覺さらましを",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "色見えてうつろふものは世中の人の心のはなにぞ有ける",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "靑柳のまゆにこもれる糸なれは春のくるにそ色まさりける",
   "kana": "",
   "speaker": "兼輔三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "夕月夜おほつかなきを玉くしけ二見の浦は明てこそみめ",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "人の親の心はやみにあらねとも子を思ふ道に迷ひぬるかな",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "万代の初めとけふを祈をきて今行末は神そかそへん",
   "kana": "",
   "speaker": "朝忠三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "くら橋の山のかひより春霞としをつみてやたち渡るらむ",
   "kana": "",
   "speaker": "三十六人撰",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "逢事のたえてしなくは中〓〓に人をも身をも恨さらまし",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "かりにくと聞に心の見えぬれは我袂にもよせしとそ思ふ",
   "kana": "",
   "speaker": "敦忠三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "あひみての後の心にくらふれは昔はものをおもはさり鳬",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "けふの日のくれさらめやはと思へともたゝぬは人の心なり鳬",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "春すきて散はてにける梅の花たゝかはかりそ枝にのこれる",
   "kana": "",
   "speaker": "高",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "かくはかりへかたくみゆる世中にうら山しくもすめる月かな",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "みても又またも見まくのほしかりし花の盛はすぎやしぬらん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "行やらて山ちくらしつほとゝきす今一聲のきかまほしさに",
   "kana": "",
   "speaker": "公忠三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "万代もなをこそあかね君か爲おもふ心のかきりなけれは",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "玉匣ふたとせあはぬ君か身をあけなからやは逢はんと思ひし",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "春立といふ計にやみよし野の山も霞てけさは見ゆらむ",
   "kana": "",
   "speaker": "忠岑三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "時しあれは秋やは人のわかるへきあるをみるたに戀しき物を",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "春はなをわれにてしりぬ花さかり心のとけき人はあらしな",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "琴の音に峯の松風かよふらしいつれの〓よりしらへそめけん",
   "kana": "",
   "speaker": "齋宮女御三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "かつみつゝ影はなれ行水の面にかく數ならぬ身をいかにせん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "雨ならでもる人もなき我やとをあさちか原とみるそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "ひとふしに千代をこめたる杖なれはつくともつきし君の齡は",
   "kana": "",
   "speaker": "賴基三首",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "我こまとけふはあひくる菖蒲草おひをくるゝやまくる成らん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "つくは山いとゝしけきに紅葉さへ道もなきまて散やしぬらん",
   "kana": "",
   "speaker": "",
   "page": 232,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "秋きぬとめにはさやかに見えねとも風の音にそ驚かれぬる",
   "kana": "",
   "speaker": "敏行三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "久方の雲のうへにてみる菊はあまつほしとそあやまたれぬる",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "こゝろから花のしつくにそほちつゝ鶯とのみ鳥のなくらん",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "ときはなる松のみとりも春くれは今一しほの色まさりけり",
   "kana": "",
   "speaker": "源宗于三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "つれもなく成行人のことの葉は秋よりさきの紅葉なりける",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "山里は冬そさひしさ勝りける人めも草もかれぬと思へは",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "こひしさはおなし心にあらすとも今宵の月を君みさらめや",
   "kana": "",
   "speaker": "信明三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "あたら夜の月と花とを同しくは心しられん人にみせはや",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "子の日してしめつる野への姫小松ひかてや千世の影を待まし",
   "kana": "",
   "speaker": "藤原〓正三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "天津風ふけゐの浦にゐる田鶴のなとか雲ゐにかへらさるへき",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "枝なから見ゆるにしきは神無月また山風のたゝぬ成けり",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "水のおもにてる月なみを數ふれはこよひそ秋の最中成ける",
   "kana": "",
   "speaker": "源",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "ちはやふる賀茂の河霧たつなかにしるきはすれる衣なりけり",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "我やとのかきれや春をへたつらん夏來にけりと見ゆる卯の花",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "契けん心そつらきたなはたの年に一たひあふはあふかは",
   "kana": "",
   "speaker": "興",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "誰をかもしる人にせん高砂の松もむかしの友ならなくに",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "君こふる淚の床にみちぬれは身をつくしとそ我は成ぬる",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "秋の野の萩のにしきを我宿にしかの音なからうつしてしかな",
   "kana": "",
   "speaker": "元輔三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "うきなからさすかに物のかなしきはいまは限りと思ふ成けり",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "音なしのそとてつゐに成ぬへきいはてもの思ふ人のなみたは",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "みよし野の山のしら雪つもるらし古〓寒く成まさるなり",
   "kana": "",
   "speaker": "是則三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "山かつと人のいへとも郭公まつ初聲は我のみそきく",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "深綠ときはの松の陰にゐてうつろふ花をよそにこそみれ",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "年〓との春のわかれをあはれとも人にをくるゝ人そしりける",
   "kana": "",
   "speaker": "元眞三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "人ならはまてといふへき時鳥また二こゑとなかて行らん",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "君こふとかつは聞つゝふる程をかくてもいける身とやみる覽",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "岩はしのよるの契も絕ぬへし明る佗しきかつらきの神",
   "kana": "",
   "speaker": "小大君三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "七夕にかしつと思ひしあふ事のそのよなきなの立にけるかな",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "限りなくとくとはすれと足引の山井の水はなをそ氷れる",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "在明の月の光をまつほとに我よのいたく更にけるかな",
   "kana": "",
   "speaker": "仲",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "ながれてとたのめし〓とは行末の淚のうへをいふにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "思ひしる人にみせはや夜もすがら我床なつにおきゐたる露",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "千とせまて限れる松もけふよりは君に引れて万代や經ん",
   "kana": "",
   "speaker": "能宣三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "紅葉せぬときはの山に立鹿はおのれ啼てや秋をしるらん",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "昨日まてよそに思ひしあやめ草けふ我やとのつまとみる哉",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "子の日する野へに小松の無りせは千世の例しに何をひかまし",
   "kana": "",
   "speaker": "忠見三首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "さよ深てねさめさりせは時鳥人つてにこそ聞へかりけれ",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "やかすとも草はもえなん春日野をたゝ春の日に任せたらなん",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "かそふれは我身につもるとし月ををくりむかふと何いそく覽",
   "kana": "",
   "speaker": "兼盛十首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "みやま出てよはにやきつる郭公あかつきかけて聲の聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "山櫻あくまて色をみつるかな花散るへくも風ふかぬ世に",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "もち月の駒ひきわたすをとす也せたのなかみち橋もとゝろに",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "暮て行秋のかたみにおくものは我もとゆひの霜にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "たよりあらはいかて都へつけやらんけふ白川の關は越ぬと",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "ことし生ひの松は七日に成にけり殘れる千代を思ひこそやれ",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "朝日さす峯のしら雪むらきえて春の霞はたなひきにけり",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "わかやとの梅の立えやみえつらむ春ひの外に君か來ませる",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "みわたせは松の葉しろき吉野山きえすつもれる雪にか有らん",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "忘られてしはしまとろむ程もかないつかは君を夢ならてみん",
   "kana": "",
   "speaker": "中務十首",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "鶯の聲なかりせば雪きえぬ山里いかて春をしらまし",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "いそのかみふるき都をきてみねは昔かさしゝ花咲にけり",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "更科にやとりはとらしおは捨の山まててらせ秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "さやかにもみるへき月を我はたゝ淚に曇る折そおほかる",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "まちつらん都の人にあふさかの關まてきぬと告やゝらまし",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "我やとの菊のしら露けふ〓とに幾代つもりて淵と成らん",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "したくゝる水に秋こそかよふらしむすふ泉の手さへ涼しき",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "咲は散りさかれは戀し山さくら思ひたえせぬ花の上かな",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "天河かはへすゝしき七夕のあふきの風を猶やかさまし",
   "kana": "",
   "speaker": "",
   "page": 233,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
